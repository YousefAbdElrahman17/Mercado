@model Mercado.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-medium mb-0">Products</h3>
    <a asp-action="Create" class="btn btn-primary rounded-3">
        <i class="ti ti-plus me-1"></i> Add Product
    </a>
</div>

<div class="row g-3">
    @foreach (var p in Model.Products)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-action="Details" asp-route-id="@p.ProductId" class="product-card">
                <div class="product-media">
                    @if (!string.IsNullOrEmpty(p.ImagePath))
                    {
                        <img src="@p.ImagePath" alt="@p.Title" />
                    }
                    else
                    {
                        <i class="ti ti-package"></i>
                    }
                </div>
                <div class="product-body">
                    <span class="product-category">@p.CategoryName</span>
                    <p class="product-title">@p.Title</p>
                    <div class="product-footer">
                        <span class="product-price">@p.Price.ToString("0.00")</span>
                        <span class="badge-stock @(p.IsLowStock ? "low" : "")">qty @p.Quantity</span>
                    </div>
                    <div class="mt-2">
                        <span class="view-count-pill"><i class="ti ti-eye"></i> @p.ViewCount</span>
                    </div>
                </div>
            </a>
            <div class="d-flex justify-content-center gap-2 mt-2">
                <a asp-action="Edit" asp-route-id="@p.ProductId" class="text-decoration-none small" style="color:var(--mercado-muted)">Edit</a>
                <span style="color:var(--mercado-border)">|</span>
                <a asp-action="Delete" asp-route-id="@p.ProductId" class="text-decoration-none small text-danger"
                   onclick="return confirm('Delete this product?');">Delete</a>
            </div>
        </div>
    }
</div>