@model Mercado.ViewModels.AddCategoryViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="form-card-category mx-auto">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="category-image-picker" id="picker">
            <i class="ti ti-photo-plus" id="pickerIcon"></i>
            <img id="previewImg" style="display:none;" />
            <input type="file" name="ImageFile" accept="image/*" onchange="previewImage(this)" />
        </div>
        <span class="font-mono small text-uppercase form-card-header" style="letter-spacing:.05em;">New Category</span>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label small text-muted"></label>
            <input asp-for="Name" class="form-control form-control-mercado"/>
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label small text-muted"></label>
            <textarea asp-for="Description" class="form-control form-control-mercado" rows="3"></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none">Cancel</a>
            <button type="submit" class="btn btn-outline-primary rounded-3 px-4">Save Category</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('picker').querySelector('input').setAttribute('form', 'createForm');

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('previewImg').style.display = 'block';
                    document.getElementById('pickerIcon').style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}