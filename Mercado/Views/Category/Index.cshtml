@model Mercado.ViewModels.CategoryListViewModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-medium mb-0">Categories</h3>
    <a asp-action="Create" class="btn btn-primary rounded-3">
        <i class="ti ti-plus me-1"></i> Add Category
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    @foreach (var c in Model.Categories)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-action="Details" asp-route-id="@c.CategoryId" class="category-tile">
                <i class="ti @c.IconClass"></i>
                <p class="category-name">@c.Name</p>
                <span class="category-count">@c.ProductsCount.ToString("00") items</span>
            </a>
            <div class="d-flex justify-content-center gap-2 mt-2">
                <a asp-action="Edit" asp-route-id="@c.CategoryId" class="text-decoration-none small" style="color:var(--mercado-muted)">Edit</a>
                <span style="color:var(--mercado-border)">|</span>
                <a asp-action="Delete" asp-route-id="@c.CategoryId" class="text-decoration-none small text-danger"
                   onclick="return confirm('Delete this category?');">Delete</a>
            </div>
        </div>
    }
</div>