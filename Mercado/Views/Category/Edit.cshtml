@model Mercado.ViewModels.EditCategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="form-card-category edit-mode mx-auto">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="category-image-picker" id="picker">
                @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                {
                    <img id="previewImg" src="@Model.CurrentImagePath" />
                }
                else
                {
                    <i class="ti ti-photo-plus" id="pickerIcon"></i>
                    <img id="previewImg" style="display:none;" />
                }
                <input type="file" name="ImageFile" accept="image/*" onchange="previewImage(this)" />
            </div>
            <span class="font-mono small text-uppercase form-card-header" style="letter-spacing:.05em;">Edit Category</span>
        </div>
        <span class="font-mono small" style="color:var(--mercado-muted);">#@Model.CategoryId.ToString("00")</span>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
        <input type="hidden" asp-for="CategoryId" />
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label small text-muted"></label>
            <input asp-for="Name" class="form-control" style="background:var(--mercado-bg); border:none;" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label small text-muted"></label>
            <textarea asp-for="Description" class="form-control" style="background:var(--mercado-bg); border:none;" rows="3"></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none">Cancel</a>
            <button type="submit" class="btn btn-primary rounded-3 px-4" style="background:var(--mercado-accent-dark); border-color:var(--mercado-accent-dark);">Update Category</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('picker').querySelector('input').setAttribute('form', 'editForm');

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('previewImg').style.display = 'block';
                    const icon = document.getElementById('pickerIcon');
                    if (icon) icon.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}