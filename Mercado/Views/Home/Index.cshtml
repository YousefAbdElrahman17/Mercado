@model Mercado.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="card p-4 mb-4">
    <span class="font-mono small text-uppercase" style="color:var(--mercado-accent-dark); letter-spacing:.05em;">Welcome back</span>
    <h2 class="fw-medium mt-1 mb-1">@Model.UserFullName</h2>
    <p class="text-muted mb-0">Here's what's happening in your inventory today.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.ProductsCount</div>
            <div class="stat-label">Products</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.CategoriesCount</div>
            <div class="stat-label">Categories</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="stat-card stat-alert">
            <div class="stat-value">@Model.LowStockCount</div>
            <div class="stat-label">Low stock</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <a asp-controller="ChatBot" asp-action="Index" class="btn btn-primary w-100 py-3 rounded-3">
            <i class="ti ti-message-chatbot me-1"></i> Ask Chatbot
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-controller="Insights" asp-action="Index" class="btn btn-outline-primary w-100 py-3 rounded-3">
            <i class="ti ti-chart-bar me-1"></i> View Insights
        </a>
    </div>
</div>